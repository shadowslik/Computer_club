        "/metrics": {
            "get": {
                "description": "Возвращает агрегированные метрики с момента запуска: количество запросов, ошибок, трафик, RPS, латентность, активные соединения.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Мониторинг"
                ],
                "summary": "Метрики сервера",
                "responses": {
                    "200": {
                        "description": "Снимок метрик",
                        "schema": {
                            "$ref": "#/definitions/metrics.Snapshot"
                        }
                    }
                }
            }
        },
        "/ratelimit": {
            "get": {
                "description": "GET — возвращает все правила. POST — создаёт новое правило для IP или подсети.\n\nПоля правила (все лимиты -1 = отключён):\n- `target`: \"ip\" или \"subnet\"\n- `value`: конкретный IP или CIDR (например 10.0.0.0/8)\n- `max_rps` / `max_rpm` / `max_rph` / `max_rpd`: лимиты запросов\n- `max_upload_bps` / `max_download_bps`: лимиты пропускной способности (байт/с)\n- `max_traffic_day`: дневной лимит трафика (байт)\n- `max_concurrent`: макс. одновременных соединений\n- `max_new_per_second`: макс. новых соединений в секунду",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rate Limiting"
                ],
                "summary": "Управление правилами rate limiting",
                "parameters": [
                    {
                        "description": "Правило rate limiting (только для POST)",
                        "name": "rule",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/domain.RateRule"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список всех правил",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.RateRule"
                            }
                        }
                    },
                    "201": {
                        "description": "Правило создано: {\\\"status\\\":\\\"ok\\\"}",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Невалидный JSON или отсутствует поле value/target",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "405": {
                        "description": "Метод не поддерживается",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Ошибка сохранения",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "GET — возвращает все правила. POST — создаёт новое правило для IP или подсети.\n\nПоля правила (все лимиты -1 = отключён):\n- `target`: \"ip\" или \"subnet\"\n- `value`: конкретный IP или CIDR (например 10.0.0.0/8)\n- `max_rps` / `max_rpm` / `max_rph` / `max_rpd`: лимиты запросов\n- `max_upload_bps` / `max_download_bps`: лимиты пропускной способности (байт/с)\n- `max_traffic_day`: дневной лимит трафика (байт)\n- `max_concurrent`: макс. одновременных соединений\n- `max_new_per_second`: макс. новых соединений в секунду",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Rate Limiting"
                ],
                "summary": "Управление правилами rate limiting",
                "parameters": [
                    {
                        "description": "Правило rate limiting (только для POST)",
                        "name": "rule",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/domain.RateRule"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Список всех правил",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.RateRule"
                            }
                        }
                    },
                    "201": {
                        "description": "Правило создано: {\\\"status\\\":\\\"ok\\\"}",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Невалидный JSON или отсутствует поле value/target",
