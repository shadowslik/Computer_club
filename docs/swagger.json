{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "HTTP proxy с управлением доступом по IP (whitelist/blacklist/graylist), rate limiting (RPS/RPM/RPH/RPD/bandwidth/соединения) и мониторингом в реальном времени.",
        "title": "Proxy API",
        "contact": {
            "name": "API Support",
            "email": "artiomk00o@gmail.com"
        },
        "license": {
            "name": "MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8081",
    "basePath": "/",
    "paths": {
        "/api/v1/upstream": {
            "get": {
                "description": "Возвращает актуальный статус всех настроенных upstream-сервисов (Java Backend, Redis, PostgreSQL и др.).\nСтатус обновляется каждые 3 секунды через health-check (HTTP GET или TCP dial).\n\nПоля ответа:\n- `status`: \"healthy\" | \"degraded\" | \"down\"\n- `latency`: последняя задержка (мс)\n- `latencyHistory`: последние 20 замеров (мс)\n- `errorRate`: процент ошибочных ответов за всё время\n- `requestsTotal`: общее число health-check запросов",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Мониторинг"
                ],
                "summary": "Статус upstream-сервисов",
                "responses": {
                    "200": {
                        "description": "Список статусов upstream-сервисов",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.UpstreamStatus"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Возвращает статус сервера, uptime, текущий RPS и количество активных соединений. Используется для liveness/readiness проб.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Мониторинг"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "status, uptime_s, rps, conns",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    }
                }
            }
        },
        "/ip/blacklist": {
            "get": {
                "description": "Возвращает все записи из выбранного списка (IP-адреса, CIDR-подсети, диапазоны).",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "IP-управление"
                ],
                "summary": "Получить IP-список",
                "responses": {
                    "200": {
                        "description": "Карта записей: ключ — IP/CIDR/диапазон, значение — true",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "boolean"
                            }
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Добавляет IP-адрес, CIDR-подсеть (например 10.0.0.0/8) или диапазон (192.168.1.1-192.168.1.254) в список. Дубликаты игнорируются.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "IP-управление"
                ],
                "summary": "Добавить запись в IP-список",
                "parameters": [
                    {
                        "example": "\"192.168.1.0/24\"",
                        "description": "IP-адрес, CIDR или диапазон",
                        "name": "ip",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "true — запись добавлена, false — уже существует",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "boolean"
                            }
                        }
                    },
                    "400": {
                        "description": "Невалидный IP/CIDR/диапазон или отсутствует тело запроса",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Ошибка сохранения",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Удаляет IP-адрес, CIDR-подсеть или диапазон из списка. Возвращает false, если записи не было.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "IP-управление"
                ],
                "summary": "Удалить запись из IP-списка",
                "parameters": [
                    {
                        "example": "\"192.168.1.0/24\"",
                        "description": "IP-адрес, CIDR или диапазон",
                        "name": "ip",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "true — запись удалена, false — не найдена",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "boolean"
                            }
                        }
                    },
                    "400": {
                        "description": "Невалидный IP или отсутствует тело запроса",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Ошибка сохранения",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/ip/check": {
            "get": {
                "description": "Определяет, в каком списке находится IP-адрес (black/gray/white/none).\nПорядок проверки: blacklist → graylist → whitelist → none.\nIP можно передать через query-параметр, тело запроса (JSON-строка) или он будет взят из RemoteAddr.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "IP-управление"
                ],
                "summary": "Проверить принадлежность IP к спискам",
                "parameters": [
                    {
                        "type": "string",
                        "example": "192.168.1.1",
                        "description": "Проверяемый IP-адрес",
                        "name": "ip",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Результат проверки",
                        "schema": {
                            "$ref": "#/definitions/handlers.CheckIpResponse"
                        }
                    },
                    "400": {
                        "description": "Невалидный IP-адрес",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/ip/denials": {
            "get": {
                "description": "Возвращает агрегированную статистику отказов: сколько раз каждый IP был заблокирован и по какой причине.\nИсточники записей: blacklist (403), graylist (429/CAPTCHA), not_in_whitelist (403 при default_deny=true).\nЗаписи накапливаются с момента запуска сервера (in-memory хранилище).\n\nПоля ответа:\n- `ip`: IP-адрес\n- `denials`: суммарное количество отказов\n- `last_denied`: время последнего отказа (RFC3339)\n- `reason`: последняя причина (\"blacklist\" | \"graylist\" | \"not_in_whitelist\")",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "IP-управление"
                ],
                "summary": "Статистика отказов доступа",
                "responses": {
                    "200": {
                        "description": "Список записей об отказах",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/domain.DenialStat"
                            }
                        }
                    }
                }
            }
        },
